		<control>pointing</control>
		<control>keyboard</control>
	</supports>
	<content_rating type="oars-1.1"/>
	<releases>
		<release version="2.0.0" date="2026-10-19">
			<description>
				<p>Rewrite of Vinegar in Rust: faster setup and installs, Studio logs read from files instead of Wine's debug channel, fixes for DNS stalls and log spam, and an MCP bridge for Roblox Studio.</p>
			</description>
		</release>
	</releases>
